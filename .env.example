# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local.

# Clave de API de Resend (solo servidor, sin prefijo NEXT_PUBLIC_).
RESEND_API_KEY=

# Remitente. Con el remitente de pruebas usa onboarding@resend.dev.
CONTACT_FROM_EMAIL=

# Destino. Con onboarding@resend.dev Resend solo entrega al correo de la cuenta de Resend.
CONTACT_TO_EMAIL=
